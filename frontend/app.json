{
  "expo": {
    "name": "Task Buddy",
    "slug": "task-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskbuddy.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.taskbuddy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1B72D8",
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "6383070f-ac0d-497a-a81e-0a305e918299"
      }
    },
    "owner": "didamsolutions"
  }
}
